# SafetyNet gateway config for `docker compose up`. Copy to `.env` and fill in.
# (Docker Compose auto-loads `.env` from this directory for ${VAR} substitution.)

# Which upstream agent the gateway forwards to:
#   stub | nemo | openai | langgraph | dify | crewai
UPSTREAM_TYPE=dify

# Base URL of the agent. For a Dify stack running via its OWN docker compose, the gateway
# (itself in Docker) reaches Dify's nginx on the host through host.docker.internal:80.
UPSTREAM_URL=http://host.docker.internal

# Dify per-app API key from the app's "API Access" page (looks like app-XXXXXXXX).
UPSTREAM_API_KEY=app-XXXXXXXX

# Only used by OpenAI-compatible upstreams (nemo/openai); ignored by Dify.
UPSTREAM_MODEL=gpt-3.5-turbo
